# Node environment (development, production, test)
NODE_ENV=production

# Next.js specific settings
NEXT_PUBLIC_BASE_URL=https://your-railway-app-url.up.railway.app

# Add any other environment variables your application needs below
# Example:
# NEXT_PUBLIC_API_URL=https://api.example.com
# DATABASE_URL=postgresql://username:password@host:port/database

# ============================================================
# Reviews Service Funnel
# ============================================================
# Reuses the shared Stripe account (STRIPE_SECRET_KEY, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY).
# Only the webhook signing secret is funnel-specific — each registered
# Stripe webhook endpoint gets its own whsec_... even within one account.
STRIPE_REVIEWS_WEBHOOK_SECRET=                  # whsec_... (from the /api/stripe/webhook-reviews endpoint)

# Production products (created via .agent/skills/manage_stripe_products/scripts/create_reviews_products.js --prefix=REV)
NEXT_PUBLIC_REV_PRODUCT_STARTER=
NEXT_PUBLIC_REV_PRODUCT_GROWTH=
NEXT_PUBLIC_REV_PRODUCT_PRO=

NEXT_PUBLIC_REV_PRICE_STARTER_MONTHLY=
NEXT_PUBLIC_REV_PRICE_STARTER_ANNUAL=
NEXT_PUBLIC_REV_PRICE_GROWTH_MONTHLY=
NEXT_PUBLIC_REV_PRICE_GROWTH_ANNUAL=
NEXT_PUBLIC_REV_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_REV_PRICE_PRO_ANNUAL=

# Test-live dummy products (LIVE-mode only; created at cutover via --prefix=REV_TL)
NEXT_PUBLIC_REV_TL_PRODUCT_STARTER=
NEXT_PUBLIC_REV_TL_PRODUCT_GROWTH=
NEXT_PUBLIC_REV_TL_PRODUCT_PRO=

NEXT_PUBLIC_REV_TL_PRICE_STARTER_MONTHLY=
NEXT_PUBLIC_REV_TL_PRICE_STARTER_ANNUAL=
NEXT_PUBLIC_REV_TL_PRICE_GROWTH_MONTHLY=
NEXT_PUBLIC_REV_TL_PRICE_GROWTH_ANNUAL=
NEXT_PUBLIC_REV_TL_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_REV_TL_PRICE_PRO_ANNUAL=

# ============================================================
# Admin Calling Dashboard ("Mission Control")
# ============================================================
# Firebase (client) — Auth ONLY. NEXT_PUBLIC_* are inlined at build → redeploy on change.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gen-lang-client-0675309660.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gen-lang-client-0675309660
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server) — service account from the Firebase console.
FIREBASE_ADMIN_PROJECT_ID=gen-lang-client-0675309660
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Access control — comma-separated emails allowed into /admin/*.
# These two Firebase accounts are already provisioned (see "Provisioned accounts" below).
ADMIN_EMAIL_ALLOWLIST=manny.lamboy23@gmail.com,elliott@texasaiconsulting.com

# Database — Postgres already on the Railway service. Set this var (do not provision a new DB).
DATABASE_URL=
